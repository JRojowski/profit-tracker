{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-fmt.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(go-developer|frontend-developer)$",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$PWD\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "env": {
    "QG_BUILD_CMD": "make gate-build",
    "QG_TEST_CMD": "make gate-test"
  },
  "worktree": {
    "symlinkDirectories": [
      "frontend/node_modules"
    ]
  }
}
