{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-fmt.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(go-developer|frontend-developer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "env": {
    "QG_BUILD_CMD": "go -C backend build ./... && make frontend-check",
    "QG_TEST_CMD": "make test && make lint"
  }
}
